# Base de datos
# Con docker-compose (ver docker-compose.yml en la raíz): usuario/password "prestocuotas".
# Con un Postgres local ya instalado: usá tus propias credenciales (p. ej. el superusuario "postgres").
DATABASE_URL="postgresql://prestocuotas:prestocuotas@localhost:5432/prestocuotas?schema=public"

# Redis (colas BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="cambiar-por-un-secreto-fuerte-de-al-menos-32-caracteres"
JWT_REFRESH_SECRET="cambiar-por-otro-secreto-fuerte-distinto-al-de-access"

# Buró de crédito (Nosis)
NOSIS_MOCK="true"          # true en dev/staging sin contrato comercial vigente
NOSIS_API_URL="https://api.nosis.com/..."
NOSIS_API_TOKEN=""

# WhatsApp (click-to-chat, wa.me)
WHATSAPP_NUMERO_EMPRESA="5491100000000"   # formato E.164 sin '+'

# Servidor
PORT=3000
